{
  "name": "happyagent",
  "version": "0.1.0",
  "description": "基于 LangGraph.js 构建、由 Kimi K2.6 驱动的 coding agent，带命令行与 Electron 桌面端（学习/研究用途）",
  "type": "module",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "smoke": "tsx src/core/smoke.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "dev:server": "langgraphjs dev --no-browser",
    "build:electron": "node scripts/build-electron.mjs",
    "desktop": "npm run build:electron && NODE_OPTIONS=--experimental-sqlite electron ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-api": "^1.4.4",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/langgraph-sdk": "^1.9.29",
    "@langchain/openai": "^1.5.8",
    "@langfuse/langchain": "^5.10.0",
    "@langfuse/otel": "^5.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "dotenv": "^16.4.0",
    "hono": "^4.13.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.4.4",
    "@types/node": "^22.0.0",
    "electron": "^43.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
